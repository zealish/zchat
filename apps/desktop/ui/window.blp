using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "ZChat";
  default-width: 1000;
  default-height: 700;

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack main_stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "qr";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage qr_page {
            title: "Scan to log in";
            description: "Open WhatsApp on your phone → Linked devices → Link a device";

            child: Gtk.Picture qr_image {
              width-request: 320;
              height-request: 320;
              can-shrink: false;
            };
          };
        };
      }

      Gtk.StackPage {
        name: "sync";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {
            show-start-title-buttons: false;
          }

          content: Adw.StatusPage sync_page {
            icon-name: "folder-download-symbolic";
            title: "Syncing your chats";
            description: "Getting your conversations and contacts ready";

            child: Gtk.Box {
              orientation: vertical;
              spacing: 12;
              halign: center;
              width-request: 360;

              Gtk.ProgressBar sync_progress {
                hexpand: true;
              }

              Gtk.Label sync_detail {
                wrap: true;
                justify: center;
                styles ["dim-label"]
              }

              Gtk.Label sync_counts {
                wrap: true;
                justify: center;
                styles ["dim-label", "caption"]
              }
            };
          };
        };
      }

      Gtk.StackPage {
        name: "chat";
        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 280;
          max-sidebar-width: 360;

          sidebar: Adw.NavigationPage {
            title: "Chats";

            child: Adw.ToolbarView {
              [top]
                Adw.HeaderBar {
                  [end]
                  Gtk.Button new_chat_button {
                    icon-name: "contact-new-symbolic";
                    tooltip-text: "New chat";
                  }

                  [end]
                  Gtk.MenuButton primary_menu_button {
                    icon-name: "open-menu-symbolic";
                    tooltip-text: "Main menu";
                    primary: true;
                    menu-model: primary_menu;
                  }
                }
              [top]
              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;

                Gtk.SearchEntry search_entry {
                  placeholder-text: "Search chats";
                }

                Adw.ToggleGroup chat_filter {
                  hexpand: true;
                  homogeneous: true;

                  Adw.Toggle {
                    name: "direct";
                    label: "Chats";
                  }

                  Adw.Toggle {
                    name: "groups";
                    label: "Groups";
                  }

                  Adw.Toggle {
                    name: "archived";
                    label: "Archived";
                  }
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Gtk.ListView chat_list {
                  styles ["navigation-sidebar"]
                };
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: "Conversation";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {
                [start]
                Adw.Avatar header_avatar {
                  size: 32;
                  show-initials: true;
                  valign: center;
                }

                title-widget: Adw.WindowTitle content_title {
                  title: "Conversation";
                };
                [end]
                Gtk.Button chat_info_button {
                  icon-name: "dialog-information-symbolic";
                  tooltip-text: "Chat information";
                }
              }

              [top]
              // No key-capture-widget: typing anywhere would otherwise be
              // swallowed by the find entry instead of the composer.
              Gtk.SearchBar find_bar {
                child: Gtk.Box {
                  orientation: horizontal;
                  spacing: 6;

                  Gtk.SearchEntry find_entry {
                    hexpand: true;
                    placeholder-text: "Find in conversation";
                  }

                  Gtk.Label find_status {
                    styles ["dim-label"]
                  }

                  Gtk.Button find_prev {
                    icon-name: "go-up-symbolic";
                    tooltip-text: "Previous match";
                    sensitive: false;
                    styles ["flat"]
                  }

                  Gtk.Button find_next {
                    icon-name: "go-down-symbolic";
                    tooltip-text: "Next match";
                    sensitive: false;
                    styles ["flat"]
                  }
                };
              }

              content: Gtk.ScrolledWindow message_scroll {
                hscrollbar-policy: never;
                vexpand: true;

                child: Gtk.ListView message_list {
                  styles ["zchat-messages"]
                };
              };

              [bottom]
              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-start: 12;
                margin-end: 12;
                margin-top: 6;
                margin-bottom: 12;

                Gtk.Box reply_bar {
                  orientation: horizontal;
                  spacing: 6;
                  visible: false;
                  styles ["zchat-reply-bar"]

                  Gtk.Box {
                    orientation: vertical;
                    hexpand: true;

                    Gtk.Label reply_sender {
                      xalign: 0;
                      ellipsize: end;
                      styles ["zchat-sender"]
                    }

                    Gtk.Label reply_body {
                      xalign: 0;
                      single-line-mode: true;
                      ellipsize: end;
                      styles ["dim-label"]
                    }
                  }

                  Gtk.Button reply_cancel {
                    icon-name: "window-close-symbolic";
                    tooltip-text: "Cancel reply";
                    valign: center;
                    styles ["flat", "circular"]
                  }
                }

                Gtk.Box attachment_bar {
                  orientation: horizontal;
                  spacing: 8;
                  visible: false;
                  styles ["zchat-attachment-bar"]

                  Gtk.Picture attachment_thumb {
                    width-request: 48;
                    height-request: 48;
                    can-shrink: true;
                    visible: false;
                    styles ["zchat-media"]
                  }

                  Gtk.Image attachment_icon {
                    pixel-size: 32;
                    visible: false;
                  }

                  Gtk.Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;

                    Gtk.Label attachment_name {
                      xalign: 0;
                      ellipsize: end;
                      styles ["zchat-sender"]
                    }

                    Gtk.Label attachment_size {
                      xalign: 0;
                      single-line-mode: true;
                      ellipsize: end;
                      styles ["dim-label"]
                    }
                  }

                  Gtk.Button attachment_cancel {
                    icon-name: "window-close-symbolic";
                    tooltip-text: "Remove attachment";
                    valign: center;
                    styles ["flat", "circular"]
                  }
                }

                Gtk.Box {
                  orientation: horizontal;
                  spacing: 6;

                  Gtk.Button attach_button {
                    icon-name: "mail-attachment-symbolic";
                    tooltip-text: "Attach a file";
                    valign: center;
                    styles ["flat", "circular"]
                  }

                  Gtk.MenuButton emoji_button {
                    icon-name: "face-smile-symbolic";
                    tooltip-text: "Insert emoji";
                    valign: center;
                    always-show-arrow: false;
                    styles ["flat", "circular"]
                  }

                  Gtk.Entry message_entry {
                    hexpand: true;
                    placeholder-text: "Write a message";
                  }

                  Gtk.Button send_button {
                    icon-name: "document-send-symbolic";
                    tooltip-text: "Send";
                    styles ["suggested-action", "circular"]
                  }
                }
              }
            };
          };
        };
      }
    };
  };
}

menu primary_menu {
  section {
    item {
      label: "Preferences";
      action: "win.preferences";
    }

    item {
      label: "Keyboard Shortcuts";
      action: "win.shortcuts";
    }

    item {
      label: "About ZChat";
      action: "win.about";
    }
  }
}
