using Gtk 4.0;
using Adw 1;

Adw.ApplicationWindow window {
  title: "ZChat";
  default-width: 1000;
  default-height: 700;

  content: Adw.ToastOverlay toast_overlay {
    child: Gtk.Stack main_stack {
      transition-type: crossfade;

      Gtk.StackPage {
        name: "qr";
        child: Adw.ToolbarView {
          [top]
          Adw.HeaderBar {}

          content: Adw.StatusPage qr_page {
            title: "Scan to log in";
            description: "Open WhatsApp on your phone → Linked devices → Link a device";

            child: Gtk.Picture qr_image {
              width-request: 320;
              height-request: 320;
              can-shrink: false;
            };
          };
        };
      }

      Gtk.StackPage {
        name: "chat";
        child: Adw.NavigationSplitView split_view {
          min-sidebar-width: 280;
          max-sidebar-width: 360;

          sidebar: Adw.NavigationPage {
            title: "Chats";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              [top]
              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-start: 6;
                margin-end: 6;
                margin-bottom: 6;

                Gtk.SearchEntry search_entry {
                  placeholder-text: "Search chats";
                }

                Adw.ToggleGroup chat_filter {
                  hexpand: true;
                  homogeneous: true;

                  Adw.Toggle {
                    name: "direct";
                    label: "Chats";
                  }

                  Adw.Toggle {
                    name: "groups";
                    label: "Groups";
                  }

                  Adw.Toggle {
                    name: "archived";
                    label: "Archived";
                  }
                }
              }

              content: Gtk.ScrolledWindow {
                hscrollbar-policy: never;
                vexpand: true;

                child: Gtk.ListView chat_list {
                  styles ["navigation-sidebar"]
                };
              };
            };
          };

          content: Adw.NavigationPage content_page {
            title: "Conversation";

            child: Adw.ToolbarView {
              [top]
              Adw.HeaderBar {}

              content: Gtk.ScrolledWindow message_scroll {
                hscrollbar-policy: never;
                vexpand: true;

                child: Gtk.ListView message_list {
                  styles ["zchat-messages"]
                };
              };

              [bottom]
              Gtk.Box {
                orientation: vertical;
                spacing: 6;
                margin-start: 12;
                margin-end: 12;
                margin-top: 6;
                margin-bottom: 12;

                Gtk.Box reply_bar {
                  orientation: horizontal;
                  spacing: 6;
                  visible: false;
                  styles ["zchat-reply-bar"]

                  Gtk.Box {
                    orientation: vertical;
                    hexpand: true;

                    Gtk.Label reply_sender {
                      xalign: 0;
                      ellipsize: end;
                      styles ["zchat-sender"]
                    }

                    Gtk.Label reply_body {
                      xalign: 0;
                      single-line-mode: true;
                      ellipsize: end;
                      styles ["dim-label"]
                    }
                  }

                  Gtk.Button reply_cancel {
                    icon-name: "window-close-symbolic";
                    tooltip-text: "Cancel reply";
                    valign: center;
                    styles ["flat", "circular"]
                  }
                }

                Gtk.Box attachment_bar {
                  orientation: horizontal;
                  spacing: 8;
                  visible: false;
                  styles ["zchat-attachment-bar"]

                  Gtk.Picture attachment_thumb {
                    width-request: 48;
                    height-request: 48;
                    can-shrink: true;
                    visible: false;
                    styles ["zchat-media"]
                  }

                  Gtk.Image attachment_icon {
                    pixel-size: 32;
                    visible: false;
                  }

                  Gtk.Box {
                    orientation: vertical;
                    hexpand: true;
                    valign: center;

                    Gtk.Label attachment_name {
                      xalign: 0;
                      ellipsize: end;
                      styles ["zchat-sender"]
                    }

                    Gtk.Label attachment_size {
                      xalign: 0;
                      single-line-mode: true;
                      ellipsize: end;
                      styles ["dim-label"]
                    }
                  }

                  Gtk.Button attachment_cancel {
                    icon-name: "window-close-symbolic";
                    tooltip-text: "Remove attachment";
                    valign: center;
                    styles ["flat", "circular"]
                  }
                }

                Gtk.Box {
                  orientation: horizontal;
                  spacing: 6;

                  Gtk.Button attach_button {
                    icon-name: "mail-attachment-symbolic";
                    tooltip-text: "Attach a file";
                    valign: center;
                    styles ["flat", "circular"]
                  }

                  Gtk.Entry message_entry {
                    hexpand: true;
                    placeholder-text: "Write a message";
                  }

                  Gtk.Button send_button {
                    icon-name: "document-send-symbolic";
                    tooltip-text: "Send";
                    styles ["suggested-action", "circular"]
                  }
                }
              }
            };
          };
        };
      }
    };
  };
}
